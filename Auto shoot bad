local function esPistolaValida(tool)
    if not tool or not tool:IsA("Tool") then return false end
    if tool:FindFirstChild("fire") and tool.fire:IsA("RemoteEvent") then
        return true
    end
    if tool:FindFirstChild("Slash") or tool:FindFirstChild("FlingKnifeEvent") then
        return false
    end
    return false
end

task.spawn(function()
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude

    local function esEnemigoAstra(p)
        if p ~= LocalPlayer and p.Character then
            local myTeam = LocalPlayer:GetAttribute("Team")
            local targetTeam = p:GetAttribute("Team")
            if myTeam and targetTeam then return myTeam ~= targetTeam end
            if LocalPlayer.Team and p.Team then return LocalPlayer.Team ~= p.Team end
            return true
        end
        return false
    end

    while screenGui.Parent do
        task.wait(0.15)

        if not getgenv().AstraAutoShotActive then
            getgenv().AstraTargetPart = nil
            isShootingVisual = false
            continue
        end

        local char = LocalPlayer.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then continue end

        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health <= 0 then continue end

        local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
        local closestTargetPart = nil
        local shortestDistance = math.huge
        local myPos = char.HumanoidRootPart.Position
        local headPos = char:FindFirstChild("Head") and char.Head.Position or myPos
        local viewportSize = Camera.ViewportSize
        local centerScreen = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)

        local playersList = Players:GetPlayers()
        for i = 1, #playersList do
            local p = playersList[i]
            if esEnemigoAstra(p) and p.Character then
                local enemyHum = p.Character:FindFirstChild("Humanoid")
                if enemyHum and enemyHum.Health > 0 then
                    params.FilterDescendantsInstances = {char, p.Character}
                    
                    local partsToCheck = {"Head", "HumanoidRootPart", "UpperTorso", "Torso"}
                    for j = 1, #partsToCheck do
                        local part = p.Character:FindFirstChild(partsToCheck[j])
                        if part and part:IsA("BasePart") then
                            
                            local pasaFov = true
                            if _G.FovCircleVisible then
                                local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
                                pasaFov = false
                                if onScreen then
                                    if (Vector2.new(screenPos.X, screenPos.Y) - centerScreen).Magnitude <= _G.AutoShootFovSize then
                                        pasaFov = true
                                    end
                                end
                            end

                            if pasaFov then
                                local dist = (part.Position - myPos).Magnitude
                                if dist < shortestDistance then
                                    if not workspace:Raycast(headPos, part.Position - headPos, params) then
                                        shortestDistance = dist
                                        closestTargetPart = part
                                    end
                                end
                            end

                        end
                    end
                end
            end
        end
        
        local armaActual = char:FindFirstChildOfClass("Tool")
        if armaActual and not esPistolaValida(armaActual) then
            armaActual = nil
        end

        if closestTargetPart then
            getgenv().AstraTargetPart = closestTargetPart
            
            if getgenv().AstraAutoEquipActive and not armaActual and backpack then
                for _, item in ipairs(backpack:GetChildren()) do
                    if esPistolaValida(item) then
                        humanoid:EquipTool(item)
                        armaActual = item
                        break
                    end
                end
            end

            if armaActual and armaActual:FindFirstChild("Handle") then
                isShootingVisual = true
                pcall(function() 
                    armaActual:Activate() 
                    task.delay(0.05, function() 
                        if armaActual.Parent == char then armaActual:Deactivate() end
                        isShootingVisual = false
                    end)
                end)
            end
        else
            getgenv().AstraTargetPart = nil
            isShootingVisual = false

            if getgenv().AstraAutoEquipActive and armaActual and backpack and esPistolaValida(armaActual) then
                armaActual.Parent = backpack
            end
        end
    end
end)

